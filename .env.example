# Copy to .env and fill in. The .env file itself is never committed.
# When you add a variable here, add it to the validation schema in src/config/ as well.

# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/re_backend?schema=public

# Authentication (placeholders; in production these come from a secret manager)
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
