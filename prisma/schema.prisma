// Marketplace database schema. No models yet — they arrive together with the first domain
// modules. For conventions and the migration workflow see prisma/CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

